# --- charon ---
# Doctrine (README §8): raw data is immutable and lives outside version control;
# derived data is regenerated only by pipeline code. Provenance artefacts
# (pull logs, metadata sidecars, checksum manifests) ARE tracked, because they are
# how a later session proves what was pulled without shipping the payload.

# Data payloads: ignored.
data/raw/**
data/derived/**

# Provenance: kept.
!data/raw/**/
!data/derived/**/
!**/.gitkeep
!data/raw/**/pull_log.jsonl
!data/raw/**/*.meta.json
!data/derived/**/*.meta.json

# D7 event calendar is hand-maintained, append-only, and IS the source of record
# (README §4 D7; the one documented exception to raw-immutability).
!data/raw/events/events.yaml

# Checksum manifests live under tests/golden/checksums/ and are always tracked.

# --- python ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- os / editor ---
.DS_Store
.idea/
.vscode/

# Secrets — never committed. Provide keys via environment or this file.
.env
.env.*
!.env.example

# docs/client_research/ WAS excluded here from 2026-08-03 until the author lifted the
# placement rule the same day (session 32R Amendment D). The named analysis is public-filings
# research and now publishes as such, in docs/appendix/.
#
# What replaced the exclusion is not nothing — it is three tests of the text, in
# tests/test_named_screen_discipline.py: citation-or-silence, a no-inside-knowledge grep, and
# a proxy-labelling check. The exclusion was a blunt instrument that made the question
# unaskable; the tests make it answerable and enforce the answer on every run.
#
# Key material and internal firm names remain blocking in scripts/pre_push_audit.py. Those
# rules were never about fund names and are untouched.
